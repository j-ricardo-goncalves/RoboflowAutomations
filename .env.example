# Roboflow credentials
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=

# Model
MODEL_WEIGHTS_PATH=/tmp/weights.pt
MODEL_WORKSPACE=
MODEL_PROJECT=
MODEL_VERSION=

# Inference settings
CONFIDENCE_THRESHOLD=50

# Class mapping — only needed if model and project class order differ
# Example: CLASS_MAP={"0":"2","1":"0","2":"1"}
CLASS_MAP=

# Image source — leave empty to fetch from Roboflow
LOCAL_IMAGE_DIR=
WORKING_DIR=

# Processing limits
MAX_IMAGES=0

# Upload settings
UPLOAD_ANNOTATIONS=true
UPLOAD_SKIPPED_IMAGES=false
UPLOAD_TAGS=
UPLOAD_BATCH_NAME=

# Output
ANNOTATION_FORMAT=both
RENDER_ANNOTATED_IMAGES=false
RUN_INFERENCE=true

# Dry run — set to true to run without writing or uploading anything
DRY_RUN=false
